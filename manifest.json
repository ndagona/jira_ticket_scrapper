{
  "manifest_version": 3,
  "name": "Jira Scraper",
  "description": "Scrap Tickets From Jira, For Now",
  "version": "1.0",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_popup": "./html/popup.html"
  },
  "permissions": [
    "storage",
    "background",
    "activeTab",
    "scripting"
  ]
}